// eShop's shared Renovate preset (#149). Every eShop repository's renovate.json extends it:
//   { "extends": ["github>pkhamdee/eshop-infra//renovate/default.json5"] }
// It keeps the pins scripts/gates/pins.sh requires (actions by commit SHA, images by digest, exact chart versions)
// current, never sooner than two weeks after a release (the project's rule for new pins), in grouped weekly PRs that
// run the same required checks as any other PR.
{
  $schema: "https://docs.renovatebot.com/renovate-schema.json",
  extends: [
    "config:recommended",
    "helpers:pinGitHubActionDigests",
    "docker:pinDigests",
    ":dependencyDashboard", // eshop-infra only in practice: the service repositories have issues turned off
  ],
  timezone: "Asia/Bangkok",
  schedule: ["before 9am on monday"],
  minimumReleaseAge: "14 days",
  // Major updates never share a PR with minor and patch ones, groups included (Renovate's default, stated: the
  // `major` rule below relies on it).
  separateMajorMinor: true,
  internalChecksFilter: "strict",
  prConcurrentLimit: 5,
  labels: ["dependencies"],
  // Kubernetes manifests and Flux objects live under deploy/ and clusters/ (Renovate only looks in
  // gotk-components.yaml for Flux by default, and nowhere for plain manifests).
  kubernetes: { managerFilePatterns: ["/^deploy/.+\\.ya?ml$/"] },
  flux: { managerFilePatterns: ["/^deploy/.+\\.ya?ml$/", "/^clusters/.+\\.ya?ml$/"] },
  packageRules: [
    {
      // The reusable gates stay at @main: that ref is part of the identity the cluster's image policy trusts (ADR 0011).
      matchDepNames: ["pkhamdee/eshop-infra"],
      enabled: false,
    },
    {
      // eShop's own images and the runner image are moved by Flux image automation and by promotion PRs, never by Renovate.
      matchPackageNames: ["docker.io/pkhamdee/**", "pkhamdee/**", "ghcr.io/actions/actions-runner"],
      matchDatasources: ["docker"],
      enabled: false,
    },
    {
      // Flux's own components are upgraded with `flux install --export` (docs/setup.md), not piecemeal.
      matchFileNames: ["clusters/local/flux-system/**"],
      enabled: false,
    },
    {
      // cosign stays on v2: v3 writes the bundle format policy-controller can't verify yet (ADR 0011).
      matchPackageNames: ["sigstore/cosign"],
      allowedVersions: "<3",
    },
    {
      // Renovate changes a tool's version but can't compute its checksums: the PR's install fails until someone runs
      // `scripts/ci/tools.sh pin <tool> <version>` on its branch.
      matchFileNames: ["scripts/ci/tools.sh"],
      prBodyNotes: ["Finish this PR on its branch with `scripts/ci/tools.sh pin {{{depName}}} {{{newVersion}}}`: Renovate can't compute the checksums, so CI fails until then."],
    },
    {
      // kubectl follows the cluster's Kubernetes minor version (k3s), which an upgrade of the cluster moves.
      matchFileNames: ["scripts/ci/tools.sh"],
      matchPackageNames: ["kubernetes/kubernetes"],
      matchUpdateTypes: ["minor", "major"],
      enabled: false,
    },
    {
      // policy-controller's tester moves with the policy-controller chart (deploy/infrastructure/controllers): together, by hand.
      matchFileNames: ["scripts/ci/tools.sh"],
      matchPackageNames: ["sigstore/policy-controller"],
      enabled: false,
    },
    { matchManagers: ["github-actions"], groupName: "GitHub Actions" },
    { matchDatasources: ["docker"], groupName: "container images" },
    { matchManagers: ["flux"], groupName: "Helm charts" },
    { matchManagers: ["custom.regex"], groupName: "pipeline tools" },
    {
      // A major version is a decision, so it gets a PR of its own (never grouped with minor and patch updates),
      // labelled `major`: reviewing and merging that PR is the approval. Not dependency-dashboard approval: the
      // service repositories have issues turned off (ADR 0009), so they have no dashboard, and a major update waiting
      // on one would never get a PR there.
      matchUpdateTypes: ["major"],
      addLabels: ["major"],
    },
  ],
  customManagers: [
    {
      // The gate scripts' tool images: NAME_IMAGE=repo:tag@sha256:digest (scripts/gates/*.sh).
      customType: "regex",
      managerFilePatterns: ["/^scripts/.+\\.sh$/"],
      matchStrings: ["[A-Z_]+_IMAGE=(?<depName>[a-z0-9./_-]+):(?<currentValue>[^@\\s]+)@(?<currentDigest>sha256:[a-f0-9]{64})"],
      datasourceTemplate: "docker",
    },
    {
      // CI's command-line tools: one row each in scripts/ci/tools.sh (name, version, datasource:package, ...).
      customType: "regex",
      managerFilePatterns: ["/^scripts/ci/tools\\.sh$/"],
      matchStrings: ["(?m)^(?<depName>[a-z][a-z0-9-]*)\\s+(?<currentValue>[0-9][^\\s]*)\\s+(?<datasource>[a-z-]+):(?<packageName>\\S+)\\s"],
      extractVersionTemplate: "^v?(?<version>.+)$",
    },
  ],
}
